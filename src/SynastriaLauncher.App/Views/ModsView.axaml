<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SynastriaLauncher.App.ViewModels"
             x:Class="SynastriaLauncher.App.Views.ModsView"
             x:DataType="vm:ModsViewModel">
  <UserControl.Resources>
    <ItemsPanelTemplate x:Key="TwoColumns">
      <UniformGrid Columns="2" />
    </ItemsPanelTemplate>

    <DataTemplate x:Key="ModTile" x:DataType="vm:ModItemViewModel">
      <Border Classes="tile" Classes.synastria="{Binding IsSynastria}">
        <DockPanel>
          <!-- Actions -->
          <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
              <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" IsVisible="{Binding ShowPresets}" IsEnabled="{Binding !IsBusy}"
                        MinWidth="170" CornerRadius="7" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip.Tip="{Binding PresetHint}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PresetOption">
                    <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Description}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Classes="primary" Content="{Binding PrimaryLabel}" Command="{Binding InstallCommand}" IsVisible="{Binding HasPrimary}" />
              <Button Content="Uninstall" Command="{Binding RemoveCommand}" IsVisible="{Binding ShowUninstall}" />
              <Button Classes="icon" ToolTip.Tip="More" IsVisible="{Binding HasMenu}">
                <PathIcon Data="{StaticResource IconMore}" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="Reinstall" Command="{Binding InstallCommand}" IsEnabled="{Binding CanReinstall}" />
                    <MenuItem Header="Uninstall" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanRemove}" IsVisible="{Binding !ShowUninstall}" />
                    <Separator IsVisible="{Binding HasHomepage}" />
                    <MenuItem Header="Open Home Page" Command="{Binding OpenPageCommand}" IsVisible="{Binding HasHomepage}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowSwitch}" VerticalAlignment="Center">
              <ToggleSwitch IsChecked="{Binding IsActive}" IsEnabled="{Binding !IsBusy}" />
              <TextBlock Classes="muted" VerticalAlignment="Center" Text="Enabled" />
            </StackPanel>
          </DockPanel>

          <!-- Details and requirements, pinned above the actions so they line up across a row -->
          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Spacing="4">
            <TextBlock Classes="small" TextWrapping="Wrap" Text="{Binding Credit}" />
            <TextBlock Classes="small" TextWrapping="Wrap" Text="{Binding Uses}" IsVisible="{Binding HasUses}" />
          </StackPanel>

          <!-- Required patch that's off -->
          <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasRequirement}" Margin="0,12,0,0" Padding="12,8"
                  CornerRadius="7" Background="{StaticResource AmberSoft}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="ghost" Padding="6,2" Command="{Binding TurnOnPatchCommand}" IsVisible="{Binding CanTurnOn}"
                      ToolTip.Tip="Switches the patch on in Patches; it's written when you apply there">
                <TextBlock Text="Turn On" Foreground="{StaticResource Amber}" FontWeight="SemiBold" />
              </Button>
              <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconWarning}" Width="14" Height="14" Margin="0,0,8,0"
                        VerticalAlignment="Center" Foreground="{StaticResource Amber}" />
              <TextBlock Text="{Binding Requirement}" Foreground="{StaticResource Amber}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <StackPanel Spacing="4">
            <DockPanel Margin="0,0,0,4">
              <Border DockPanel.Dock="Right" Classes="pill" Classes.good="{Binding IsGood}" Classes.accent="{Binding IsAccent}" IsVisible="{Binding ShowState}">
                <TextBlock Text="{Binding StateLabel}" />
              </Border>
              <TextBlock Classes="name" FontSize="17" Text="{Binding Name}" />
            </DockPanel>
            <TextBlock TextWrapping="Wrap" Text="{Binding Summary}" />
            <TextBlock Classes="muted" FontSize="12.5" Text="{Binding Details}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="32,28,32,32" MaxWidth="980">
      <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Command="{Binding LoadCommand}" IsEnabled="{Binding CanCheck}"
                ToolTip.Tip="Gets the latest list of mods and their versions">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconRefresh}" Width="15" Height="15" />
            <TextBlock Text="{Binding CheckLabel}" />
          </StackPanel>
        </Button>
        <StackPanel>
          <TextBlock Classes="pageTitle" Text="Mods" />
          <TextBlock Classes="pageSubtitle" Text="Optional extras that run inside the game. If the game acts strange after adding one, switch it off." />
        </StackPanel>
      </DockPanel>

      <StackPanel Classes="sectionHeader" Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="section" Text="Made for Synastria" />
        <Border Classes="pill accent">
          <TextBlock Text="Included with the Launcher" />
        </Border>
      </StackPanel>
      <TextBlock Classes="sectionNote"
                 Text="Built and tested for Synastria. They ship inside the launcher, so they install offline and update when the launcher does." />
      <ItemsControl Classes="tileGrid" ItemsSource="{Binding SynastriaItems}" ItemsPanel="{StaticResource TwoColumns}" ItemTemplate="{StaticResource ModTile}" />

      <TextBlock Classes="section" Text="Community Mods" />
      <StackPanel Classes="sectionNote">
        <TextBlock Text="General WoW 3.3.5 mods by other authors, downloaded from their own releases. Problems with one go to its author." />
        <TextBlock Text="{Binding DllFolderNote}" />
      </StackPanel>
      <ItemsControl Classes="tileGrid" ItemsSource="{Binding CommunityItems}" ItemsPanel="{StaticResource TwoColumns}" ItemTemplate="{StaticResource ModTile}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
