<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SynastriaLauncher.App.ViewModels"
             x:Class="SynastriaLauncher.App.Views.SettingsView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,28,32,32" MaxWidth="980">
      <TextBlock Classes="pageTitle" Text="Settings" />

      <TextBlock Classes="section" Text="Game" />
      <Border Classes="panel">
        <StackPanel>
          <Border Classes="row">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Open" Command="{Binding OpenGameFolderCommand}" IsEnabled="{Binding HasGameFolder}" />
                <Button Classes="primary" Content="Change" Command="{Binding ChooseGameFolderCommand}" />
              </StackPanel>
              <StackPanel Spacing="4" Margin="0,0,12,0">
                <TextBlock Classes="name" Text="Game Folder" />
                <TextBlock Classes="muted" Text="{Binding GameFolderLabel}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row" BorderThickness="0" IsVisible="{Binding HasGameFolder}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsEnabled="{Binding WowExt.IsIdle}">
                <Button Command="{Binding WowExt.CheckCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconRefresh}" Width="15" Height="15" Classes.spin="{Binding WowExt.IsBusy}" />
                    <TextBlock Text="Check for Updates" />
                  </StackPanel>
                </Button>
                <Button Classes="primary" Content="Update" Command="{Binding WowExt.UpdateCommand}" IsVisible="{Binding WowExt.HasUpdate}" />
                <Button Classes="icon" ToolTip.Tip="More">
                  <PathIcon Data="{StaticResource IconMore}" />
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="Install from a Downloaded Zip" Command="{Binding WowExt.InstallFromZipCommand}" />
                      <MenuItem Header="Open Download Page" Command="{Binding WowExt.OpenDownloadPageCommand}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
              <StackPanel Spacing="4" Margin="0,0,12,0">
                <TextBlock Classes="name" Text="{Binding WowExt.Installed}" />
                <TextBlock Classes="muted" Text="Synastria's client files (WowExt.exe, WoWExt.dll and its data), updated from the download on synastria.org." TextWrapping="Wrap" />
                <TextBlock Classes="small" Text="{Binding WowExt.Status}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="Accounts" />
      <Border Classes="panel">
        <StackPanel>
          <Border Classes="row">
            <DockPanel>
              <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Accounts.LaunchChoices}" SelectedItem="{Binding Accounts.LaunchChoice}"
                        MinWidth="220" VerticalAlignment="Center" CornerRadius="7">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LaunchOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Spacing="4" Margin="0,0,12,0">
                <TextBlock Classes="name" Text="Launch Logs In As" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="What the Launch button logs in as. Hold Shift while the game starts to skip it." />
              </StackPanel>
            </DockPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Accounts.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AccountItemViewModel">
                <StackPanel>
                  <Border Classes="row">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Add Character" Command="{Binding AddCharacterCommand}"
                                ToolTip.Tip="A character this account can go straight into the world as" />
                        <Button Content="Create Shortcut" Command="{Binding CreateShortcutCommand}"
                                ToolTip.Tip="A desktop shortcut that starts the game through the launcher, logs in and stops at character select" />
                        <Button Classes="icon" ToolTip.Tip="More">
                          <PathIcon Data="{StaticResource IconMore}" />
                          <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                              <MenuItem Header="Edit Account" Command="{Binding EditCommand}" />
                              <MenuItem Header="Remove Account" Command="{Binding RemoveCommand}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                      <StackPanel Spacing="4" Margin="0,0,12,0">
                        <TextBlock Classes="name" Text="{Binding Name}" />
                        <TextBlock Classes="muted" Text="{Binding Detail}" TextWrapping="Wrap" />
                        <TextBlock Classes="small" Foreground="{StaticResource Bad}" IsVisible="{Binding PasswordUnreadable}"
                                   Text="The saved password can't be read on this Windows user; edit the account to enter it again" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Characters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CharacterItemViewModel">
                        <Border Classes="row" Padding="40,8,16,8">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                              <Button Content="Create Shortcut" Command="{Binding CreateShortcutCommand}"
                                      ToolTip.Tip="A desktop shortcut that starts the game through the launcher and goes straight into the world as this character" />
                              <Button Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this character">
                                <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" />
                              </Button>
                            </StackPanel>
                            <TextBlock Classes="name" Text="{Binding Name}" VerticalAlignment="Center" />
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="row" BorderThickness="0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="primary" Content="Add Account" Command="{Binding Accounts.AddCommand}" VerticalAlignment="Center" />
              <StackPanel Spacing="4" Margin="0,0,12,0">
                <TextBlock Classes="name" Text="Auto Login" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Save an account to log in without typing, and add its characters to go straight into the world. Passwords are encrypted for your Windows user. Needs the DLL Loader patch." />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="Addons" />
      <Border Classes="panel">
        <StackPanel>
          <Border Classes="row">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Copy Settings" Command="{Binding CopyCharacterSettingsCommand}" VerticalAlignment="Center"
                      ToolTip.Tip="Pick the characters and what to copy first; replaced files are backed up" />
              <StackPanel Spacing="4" Margin="0,0,12,0">
                <TextBlock Classes="name" Text="Copy Character Settings" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Give one character another's addon profiles, enabled addons, frame positions, chat windows and game options." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Choose Characters" Command="{Binding ShareChatWindowsCommand}" VerticalAlignment="Center" />
              <StackPanel Spacing="4" Margin="0,0,12,0">
                <TextBlock Classes="name" Text="Shared Chat Windows" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SharedChatSummary}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row" BorderThickness="0">
            <DockPanel>
              <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding KeepAddonBackups}" VerticalAlignment="Center" />
              <StackPanel Spacing="4" Margin="0,0,12,0">
                <TextBlock Classes="name" Text="Keep the Previous Version" />
                <TextBlock Classes="muted" Text="When an addon updates, keep the old copy as a .bak folder in AddOns." />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="Backups" />
      <Border Classes="panel">
        <StackPanel>
          <Border Classes="row">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Move Aside" Command="{Binding MoveLeftoverSettingsCommand}" IsEnabled="{Binding HasLeftoverSettings}"
                      VerticalAlignment="Center" ToolTip.Tip="Lists them first; they move to WTF\_RemovedAddonSettings" />
              <StackPanel Spacing="4" Margin="0,0,12,0">
                <TextBlock Classes="name" Text="Removed Addons' Settings" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding LeftoverSettingsSummary}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row" BorderThickness="0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Clean Up" Command="{Binding CleanUpBackupsCommand}" IsEnabled="{Binding HasBackups}"
                      VerticalAlignment="Center" ToolTip.Tip="Lists them first; they go to the Recycle Bin" />
              <StackPanel Spacing="4" Margin="0,0,12,0">
                <TextBlock Classes="name" Text="Old Backups" />
                <TextBlock Classes="muted" Text="{Binding BackupSummary}" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="Launcher" />
      <Border Classes="panel">
        <StackPanel>
          <Border Classes="row">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding CheckLauncherUpdateCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconRefresh}" Width="15" Height="15" Classes.spin="{Binding IsCheckingLauncher}" />
                    <TextBlock Text="Check for Updates" />
                  </StackPanel>
                </Button>
                <Button Classes="primary" Content="Update" Command="{Binding UpdateLauncherCommand}"
                        IsVisible="{Binding LauncherUpdate, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <StackPanel Spacing="4" Margin="0,0,12,0">
                <TextBlock Classes="name" Text="Synastria Launcher" />
                <TextBlock Classes="muted" Text="{Binding Version}" />
                <TextBlock Classes="small" Text="{Binding LauncherUpdateStatus}" />
                <TextBlock Classes="small" TextWrapping="Wrap" Text="Unofficial: made by players, not by Synastria's team." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row" BorderThickness="0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Open" Command="{Binding OpenDataFolderCommand}" VerticalAlignment="Center" />
              <StackPanel Spacing="4" Margin="0,0,12,0">
                <TextBlock Classes="name" Text="Launcher Data" />
                <TextBlock Classes="muted" Text="Where the launcher keeps its settings and install records." />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
